/* =========================
   売却相談 HERO
========================= */

.baikyaku-hero{

  position: relative;

  color: #fff;

  overflow: hidden;

  background:
    linear-gradient(
      90deg,
      rgba(7, 27, 63, 0.92) 0%,
      rgba(7, 27, 63, 0.72) 42%,
      rgba(7, 27, 63, 0.22) 100%
    ),
    url("hero-baikyaku.jpg")
    center center / cover no-repeat;

}
