/* =========================
   管理委託 HERO
========================= */

.kanri-hero{

  position: relative;

  color: #fff;

  overflow: hidden;

  background:
    linear-gradient(
      90deg,
      rgba(5, 28, 65, 0.94) 0%,
      rgba(5, 28, 65, 0.74) 42%,
      rgba(5, 28, 65, 0.24) 100%
    ),
    url("hero-kanri.jpg")
    center center / cover no-repeat;

}
